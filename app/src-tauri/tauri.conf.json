{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LabelLab",
  "version": "0.1.0",
  "identifier": "io.github.itsh-neumeier.labellab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LabelLab",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "ITSH Neumeier",
    "copyright": "© 2026 Timo Neumeier · ITSH Neumeier · MIT"
  },
  "mainBinaryName": "LabelLab"
}
